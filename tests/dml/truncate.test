#

open E0 "uuid": "00000000-0000-0000-0000-000000000001", "listen": [{ "host": "127.0.0.1", "port": 3485 }];
connect E0 S0 127.0.0.1:3485;

# test: truncate parsing
truncate;
truncate if not;

# test: truncate
create table test (id int primary key);
insert into test values (1),(2),(3),(4),(5);
truncate test;
select * from test;

# test: truncate (empty)
truncate test;
select * from test;

# test: insert after truncate
insert into test values (6),(7),(8);
select * from test;
truncate test;
select * from test;

insert into test values (6),(7),(8);
select * from test;
truncate test;
select * from test;

insert into test values (6),(7),(8);
select * from test;
truncate test;
select * from test;

drop table test;

# test: truncate (hash)
create table test (id int primary key using hash);
insert into test values (1),(2),(3),(4);
select * from test;
truncate test;
select * from test;
drop table test;

# test: truncate (vector)
create table test (id int primary key, v vector(2));
insert into test values (1, vector [1,1]);
insert into test values (2, vector [1,2]);
insert into test values (3, vector [1,3]);
select * from test;
select * from test matching v to vector [1,1] top 2;
truncate test;
select * from test;

select * from test matching v to vector [1,1] top 2;
insert into test values (1, vector [1,4]);
select * from test matching v to vector [1,1] top 2;
drop table test;

disconnect S0;
close E0;
