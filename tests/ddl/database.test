#

open E0 "uuid": "00000000-0000-0000-0000-000000000001", "listen": [{ "host": "127.0.0.1", "port": 3485 }];
connect E0 S0 127.0.0.1:3485;

# test: ensure system databases exists
select show('databases')[0].name;
select current_database;

# test: create database statement parsing
create;
create database;
create database 123;
create database if;
create database if not;
create database if not 123;
create database if not exists;
create database test abc;

# test: create database
create database test;
select show('database', 'test').name;

# test: create database if not exists
create database test;
create database if not exists test;
select show('database', 'test').name;

# test: create database description
create database test_with_desc description 'test test!';
show databases;

# test: create database limit
create database test_limit limit;
create database test_limit limit name;
create database test_limit limit name;
create database test_limit limit name to;
create database test_limit limit name =;
create database test_limit limit name = value;
create database test_limit limit name = 123;
create database test_limit limit send = 123;
select show('database', 'test_limit', null, "verbose").limits;

# test: drop database statement parsing
drop database;
drop database 123;
drop database if;
drop database if exists;
drop database test abc;

# test: drop database
drop database test;
select show('database', 'test').name;
drop database test_with_desc;
drop database test_limit;

# test: drop database if exists
drop database test;
drop database if exists test;
select show('database', 'test').name;

# test: drop amelie database
drop database amelie;
select show('database', 'test').name;
select show('database', 'amelie').name;

# test: drop connected database
create database test;
select show('database', 'test').name;

connect E0 S1 127.0.0.1:3485/test;
switch S1;
select current_database;

drop database test;
disconnect S1;
switch S0;

select current_database;
show databases;

drop database test;
drop database if exists test;

# test: alter database statment parsing
alter database;
alter database 123;
alter database test;
alter database test rename;
alter database test rename to;
alter database test rename "hello";

# test: alter database rename
create database test;
select show('database', 'test').name;
select show('database', 'hello').name;

alter database test rename to test2;
select show('database', 'test').name;
select show('database', 'test2').name;
drop database test2;

# test: alter database amelie
alter database amelie rename to _public;
select show('database', 'amelie').name;

# test: alter database rename cascade (udf dep)
create database test;
connect E0 S1 127.0.0.1:3485/test;
switch S1;

create table a(id int primary key);
insert into a values (1), (2), (3);

create table b(id int primary key);
create function fn() return int
begin
	total int = 0;
	select count(*) into total from a;
	return total;
end;
select fn();

drop function fn;

# test: alter database rename cascade
switch S0;

alter database test rename to test2;
select 1;

switch S1;
disconnect S1;
connect E0 S1 127.0.0.1:3485/test2;
switch S1;

show tables;
show functions;
select show('database', 'amelie').name;
select show('database', 'test2').name;

disconnect S1;
switch S0;

show tables;
show functions;
select show('database', 'amelie').name;
select show('database', 'test2').name;

drop database test2;
drop database test2 cascade;

# test: alter database description
create database test;
alter database test description;
alter database test description 123;
alter database test description 'test test';
show databases;
alter database test description '';
show databases;
drop database test;

# test: alter database set limit
create database test;
alter database test set;
alter database test set 123;
alter database test set limit;
alter database test set limit write;
alter database test set limit write =;
alter database test set limit write = 123;
select show('database', 'test', null, "verbose").limits;
alter database test set limit write = 123,;
alter database test set limit write = 123, send = 123;
select show('database', 'test', null, "verbose").limits;

# test: alter database unset limit
alter database test unset;
alter database test unset 123;
alter database test unset limit;
# unknown
alter database test unset limit name;
alter database test unset limit write;
select show('database', 'test', null, "verbose").limits;
alter database test unset limit write,;
alter database test unset limit write, send;
select show('database', 'test', null, "verbose").limits;
drop database test;

disconnect S0;
close E0;
