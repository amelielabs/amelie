#

open E0 "uuid": "00000000-0000-0000-0000-000000000001", "listen": [{ "host": "127.0.0.1", "port": 3485 }];
connect E0 S0 127.0.0.1:3485;

# test: double
select 1.0e0;
select 1.0e0::type;
select 3.14e0;
select 1.1234e0;

# test: double limits

# flt_min
select 1.17549e-38;

# flt_max
select 3.40282e+38;

# dbl_min
select 2.2250738585072014e-308;
select 1e-307;

# dbl_max
select 1.79769e+308;
select 1e+308;

# test: double overflow
select 1.79770e+308;
select 2.2250738585072014e-309;

select 1e1;
select 1e2;
select 1e4;
select 1e8;
select 1e40;

# test: double = bool
select 1.0e0 = true;
select 1.34e0 = true;
select 1.34e0 = false;
select 0.34e0 = false;
select 0.0e0 = false;
explain select 0.0e0 = false;

# test: double = int
select 1.0e0 = 1;
select 12.3e0 = 1;
select 0.14e0 = 1;
explain select 1.0000e0 = 1;

# test: double = double
select 12.3e0 = 1.3e0;
select 12.3e0 = 12.3e0;
select 12.3e0 = 12.4e0;
explain select 12.3e0 = 12.4e0;

# test: double = null
select 12.3e0 = null;
explain select 12.3e0 = null;

# test: double = unsupported
select 12.3e0 = [1,2e0];

# test: double <> bool
select 1.0e0 <> true;
select 1.34e0 <> true;
select 1.34e0 <> false;
select 0.34e0 <> false;
select 0.0e0 <> false;
explain select 0.0e0 <> false;

# test: double <> int
select 1.0e0 <> 1;
select 12.3e0 <> 1;
select 0.14e0 <> 1;
explain select 1.0000e0 <> 1;

# test: double <> double
select 12.3e0 <> 1.3e0;
select 12.3e0 <> 12.3e0;
select 12.3e0 <> 12.4e0;
explain select 12.3e0 <> 12.4e0;

# test: double <> null
select 12.3e0 <> null;
explain select 12.3e0 <> null;

# test: double <> unsupported
select 12.3e0 <> [1,2e0];

# test: double >= int
select 0.11e0 >= 1;
select 1.11e0 >= 1;
select 1.0e0 >= 1;
explain select 11.1e0 >= 1;

# test: double >= double
select 0.11e0 >= 1.2e0;
select 1.11e0 >= 1.11e0;
select 1.13e0 >= 1.13e0;
explain select 1.11e0 >= 1.13e0;

# test: double >= null
select 0.11e0 >= null;
explain select 0.11e0 >= null;

# test: double >= unsupported
select 0.11e0 >= [];

# test: double > int
select 0.11e0 > 1;
select 1.11e0 > 1;
select 1.0e0 > 1;
explain select 11.1e0 > 1;

# test: double > double
select 0.11e0 > 1.2e0;
select 1.11e0 > 1.11e0;
select 1.13e0 > 1.13e0;
explain select 1.11e0 > 1.13e0;

# test: double > null
select 0.11e0 > null;
explain select 0.11e0 > null;

# test: double > unsupported
select 0.11e0 > [];

# test: double <= int
select 0.11e0 <= 1;
select 1.11e0 <= 1;
select 1.0e0 <= 1;
explain select 11.1e0 <= 1;

# test: double <= double
select 0.11e0 <= 1.2e0;
select 1.11e0 <= 1.11e0;
select 1.13e0 <= 1.13e0;
explain select 1.11e0 <= 1.13e0;

# test: double <= null
select 0.11e0 <= null;
explain select 0.11e0 <= null;

# test: double <= unsupported
select 0.11e0 <= [];

# test: double < int
select 0.11e0 < 1;
select 1.11e0 < 1;
select 1.0e0 < 1;
explain select 11.1e0 < 1;

# test: double < double
select 0.11e0 < 1.2e0;
select 1.11e0 < 1.11e0;
select 1.13e0 < 1.13e0;
explain select 1.11e0 < 1.13e0;

# test: double < null
select 0.11e0 < null;
explain select 0.11e0 < null;

# test: double < unsupported
select 0.11e0 < [];

# test: double + int
select 1.5e0 + 1;
explain select 1.5e0 + 1;

# test: double + double
select 1.5e0 + 1.5e0;
explain select 1.5e0 + 1.5e0;

# test: double + null
select 1.5e0 + null;

# test: double + unsupported
select 1.5e0 + [];

# test: double - int
select 1.5e0 - 1;
explain select 1.5e0 - 1;

# test: double - double
select 1.5e0 - 1.5e0;
explain select 1.5e0 - 1.5e0;

# test: double - null
select 1.5e0 - null;

# test: double - unsupported
select 1.5e0 - [];

# test: double * int
select 1.5e0 * 2;
explain select 1.5e0 * 2;

# test: double * int (overflow)
select 1e+308 * 2;

# test: double * double
select 1.5e0 * 1.5e0;
explain select 1.5e0 * 1.5e0;

# test: double * null
select 1.5e0 * null;

# test: double * unsupported
select 1.5e0 * [];

# test: double / int
select 3.5e0 / 2;
explain select 3.5e0 / 2;
select 3.5e0 / 0;

# test: double / double
select 3.5e0 / 1.5e0;
explain select 3.5e0 / 1.5e0;
select 3.5e0 / 0.0e0;

# test: double / null
select 1.5e0 / null;

# test: double / unsupported
select 1.5e0 / [];

# test: -double
select -18.8e0;
explain select -18.8e0;

disconnect S0;
close E0;
