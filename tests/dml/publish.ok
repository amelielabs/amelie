6    publish  ["8"]
7    publish  [16]
8    publish  {"id": 48, "data": 16, "hash": "fe5dbbcea5ce7e2988b8c69bcfdfde8904aabc1f"}
publish into x 1,2,3;
publish into x (1 * 2)::json, (2 * 2)::json, (3 * 2::string::int)::json;
select * from sub;

lsn  cmd      data
──────────────────────────────────────────────────────────────────────────────────────────
4    publish  123
