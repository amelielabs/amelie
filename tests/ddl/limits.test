#

open E0 "uuid": "00000000-0000-0000-0000-000000000001", "listen": [{ "host": "127.0.0.1", "port": 3485 }];
connect E0 S0 127.0.0.1:3485;

# test: default
show limits;

# test: write
create table test (id int primary key);
alter database amelie set limit write = 1;
insert into test values (123);
# error
insert into test values (124), (125);
drop table test;
alter database amelie unset limit write;

# test: send
alter database amelie set limit send = 0;
# error
show limits;
alter database amelie unset limit send;
show limits;

# test: recv
disconnect S0;
close E0;
open E0 "recv": 0;
connect E0 S0 127.0.0.1:3485;
select 1;

disconnect S0;
close E0;

open E0;
connect E0 S0 127.0.0.1:3485;

# test: tables
alter database amelie set limit tables = 0;
create table test (id int primary key);
alter database amelie set limit tables = 1;
create table test (id int primary key);
drop table test;

# test: indexes
create table test (id int primary key);
alter database amelie set limit indexes = 1;
create index i on test (id);
alter database amelie set limit indexes = 2;
create index i on test (id);
drop table test;

# test: functions
alter database amelie set limit functions = 0;
create function test () begin end;
alter database amelie set limit functions = 1;
create function test () begin end;
select test();
drop function test;

# test: columns
alter database amelie set limit columns = 1;
create table test (id int primary key);
create table test2 (id int primary key, data int);
drop table test;
alter database amelie unset limit columns;

# test: keys
alter database amelie set limit keys = 1;
create table test (id int primary key);
drop table test;
create table test (id int, data int, primary key (id, data));
alter database amelie unset limit keys;

# test: args
alter database amelie set limit args = 0;
create function test() begin end;
create function test2(id int) begin end;
drop function test;
alter database amelie unset limit args;

# test: values
alter database amelie set limit values = 1;
create table test (id int primary key);
insert into test values (1);
insert into test values (2), (3);
drop table test;

# test: vector
alter database amelie set limit vector = 1;
create table test (id int primary key, v vector(1));
create table test2 (id int primary key, v vector(3));
drop table test;
alter database amelie unset limit vector;
show limits;

# test: compute
alter database amelie set limit compute = 100;
explain while 1 do end;
while 1 do end;

# test: memory
show rels;
show memory;

create table test (id int primary key, data int);
show memory;

insert into test values (1, 0);
show memory;

drop table test;
show memory;

alter database amelie set limit memory = 128;
show memory;
show limits;

create table test (id int primary key, data int);

insert into test values (1, 0);
select * from test;

alter database amelie unset limit memory;
show memory;
show limits;

insert into test values (1, 0);

drop table test;
show memory;

disconnect S0;
close E0;
