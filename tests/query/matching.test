# test: matching (delete)
delete from products where id = 1;
select id from products matching v to vector [1.1, 0.05] top 2;

# test: matching (delete multi-stmt)
begin
  delete from products where id = 2;
  select id from products matching v to vector [1.1, 0.05] top 2;
end;

# test: matching (delete multi-stmt abort)
begin
  delete from products where id = 4;
  select error("abort");
end;
select id from products matching v to vector [1.1, 0.05] top 2;

drop table products;

# test: matching (where)
create table inventory (id int primary key, category_id int, v vector(2)) partitions 2;
insert into inventory values (1, 10, vector [0.99, 0.01]);
insert into inventory values (2, 20, vector [0.90, 0.10]);
insert into inventory values (3, 20, vector [0.10, 0.90]);
# 2
select id from inventory matching v to vector [1.0, 0.0] top 2 where category_id = 20;
drop table inventory;

disconnect S0;
close E0;
