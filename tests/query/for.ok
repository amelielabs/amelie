# test: for for if break
explain begin
	declare last int := 0;
	declare loops int := 0;
	for i in ([0,1,2,3]) do
		for j in ([0,1,2,3]) do
			last := j::int;
			if last = 3 then
				break;
			end;
		end;
		loops := loops + 1;
	end;
	select loops, last;
end;

