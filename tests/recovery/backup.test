#

open E0 "uuid": "abc00000-0000-0000-0000-000000000000", "listen": [{ "host": "127.0.0.1", "port": 3485 }];
connect E0 S0 127.0.0.1:3485;

# test: checkpoint
show all;
show state;

create table test (id int primary key);
insert into test values (1), (2), (3);

create table test_vector(id int primary key, v1 vector(2));
create table l on test_vector;

insert into test_vector values (0, vector [0,0]);
insert into test_vector values (1, vector [1,1]);
insert into l values (2, vector [2,2]);
insert into l values (3, vector [3,3]);

checkpoint;
insert into test values (4);
insert into l values (4, vector [4,4]);
insert into l values (5, vector [5,5]);

show state;

# test: backup
backup id "00000000-0000-0000-0000-000000000001";

disconnect S0;
close E0;

# test: restore from backup
restore E1 E0/backup/00000000-0000-0000-0000-000000000001;

open E1;
connect E1 S1 127.0.0.1:3485;

show all;
show state;
select * from test;
select * from test_vector;
select * from l;

disconnect S1;
close E1;
