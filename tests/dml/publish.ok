open E0 "uuid": "00000000-0000-0000-0000-000000000001", "listen": [{ "host": "127.0.0.1", "port": 3485 }];
connect E0 S0 127.0.0.1:3485;
# test: publish (expr)
create topic x;
create subscription sub on x;
explain publish into x 123;

explain
───────

main
  0   publish             -      -      -     # amelie.x
  1   ret                 -1     0      -

access
  •   amelie.x shared_rw [publish]
publish into x 123;
select * from sub;

lsn  cmd      data
────────────────────
4    publish  123
explain publish into x [2 + 2];

explain
───────

main
  0   int                 0      -      0     # 2
  1   int                 1      -      0     # 2
  2   addii               2      0      1
  3   push                2      0      0
  4   json_array          0      1      0
  5   push_ref            0      0      0
  6   publish             -      -      -     # amelie.x
  7   ret                 -1     0      -

access
  •   amelie.x shared_rw [publish]
publish into x [2 + 2];
select * from sub;

lsn  cmd      data
────────────────────
4    publish  123
5    publish  [4]
# test: publish (func constify)
publish into x [8::string];
select * from sub;

lsn  cmd      data
─────────────────────
4    publish  123
5    publish  [4]
6    publish  ["8"]
# test: publish (func)
publish into x [8::string::int * 2];
select * from sub;

lsn  cmd      data
─────────────────────
4    publish  123
5    publish  [4]
6    publish  ["8"]
7    publish  [16]
# test: publish (expr json)
publish into x {
	"id": 48,
	"data": 8::string::int * 2,
	"hash": 8::string::sha1
};
select * from sub;

lsn  cmd      data
──────────────────────────────────────────────────────────────────────────────────────────
4    publish  123
