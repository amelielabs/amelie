#

open E0 "uuid": "00000000-0000-0000-0000-000000000001", "listen": [{ "host": "127.0.0.1", "port": 3485 }];
connect E0 S0 127.0.0.1:3485;

# test: matching parsing
create table test (id int primary key, v vector(1)) partitions 1;
insert into test values (1, vector [1.1]);
insert into test values (2, vector [1.2]);
insert into test values (3, vector [1.3]);
insert into test values (4, vector [1.4]);
insert into test values (5, vector [1.5]);

select * from test;
select * from test matching;
select * from test matching id;
select * from test matching v;
select * from test matching v to;
select * from test matching v to 123;
select * from test matching v to vector [1.35];
select * from test matching v to vector [1.35] top;

# test: matching
select * from test matching v to vector [1.35e0] top 3;
drop table test;

# test: matching (1 partitions)
create table products (id int primary key, v vector(2)) partitions 1;
insert into products values (1, vector [1.0, 0.1]);
insert into products values (2, vector [0.9, 0.2]);
insert into products values (3, vector [0.2, 0.9]);
insert into products values (4, vector [0.5, 0.5]);
select id from products matching v to vector [1.1, 0.05] top 2;
drop table products;

# test: matching negative values (1 partition)
create table embeddings (id int primary key, v vector(3)) partitions 1;
insert into embeddings values (1, vector [-0.9, -0.8, -0.1]);
insert into embeddings values (2, vector [0.8, 0.9, 0.1]);
insert into embeddings values (3, vector [-0.1, 0.2, -0.9]);

select id from embeddings matching v to vector [-1.0, -1.0, 0.0] top 1;
drop table embeddings;

# test: matching (6 partitions)
create table products (id int primary key, v vector(2)) partitions 6;
insert into products values (1, vector [1.0, 0.1]);
insert into products values (2, vector [0.9, 0.2]);
insert into products values (3, vector [0.2, 0.9]);
insert into products values (4, vector [0.5, 0.5]);
select id from products matching v to vector [1.1, 0.05] top 2;

