#

open E0 "uuid": "00000000-0000-0000-0000-000000000000", "listen": [{ "host": "127.0.0.1", "port": 3485 }];
connect E0 S0 127.0.0.1:3485;

# test: POST /import (invalid content type)
post /import - - -;
post /import json - -;
post /import/ application/json - -;

# test: POST /import (text/plain, no accept, no content)
post /import text/plain - -;

disconnect S0;
close E0;
