#

open E0 "uuid": "00000000-0000-0000-0000-000000000001", "listen": [{ "host": "127.0.0.1", "port": 3485 }];
connect E0 S0 127.0.0.1:3485;

# test: default
show limits;

# test: write
create table test (id int primary key);
alter user amelie set limit write = 1;
insert into test values (123);
# error
insert into test values (124), (125);
drop table test;
alter user amelie unset limit write;

# test: send
alter user amelie set limit send = 0;
# error
show limits;
alter user amelie unset limit send;
show limits;

# test: recv
disconnect S0;
close E0;
open E0 "recv": 0;
connect E0 S0 127.0.0.1:3485;
select 1;

disconnect S0;
close E0;

open E0;
connect E0 S0 127.0.0.1:3485;

# test: users
alter user amelie set limit users = 0;
create user test;
# amelie is owner to self
alter user amelie set limit users = 2;
show limits;
create user test;
drop user test;

# test: tables
alter user amelie set limit tables = 0;
create table test (id int primary key);
alter user amelie set limit tables = 1;
create table test (id int primary key);
drop table test;

# test: indexes
create table test (id int primary key);
alter user amelie set limit indexes = 1;
create index i on test (id);
alter user amelie set limit indexes = 2;
create index i on test (id);
drop table test;

# test: clones
create table test (id int primary key);
alter user amelie set limit clones = 0;
create clone test_clone of test;
alter user amelie set limit clones = 1;
create clone test_clone of test;
create clone test_clone2 of test;
drop table test cascade;

# test: topics
alter user amelie set limit topics = 0;
create topic test;
alter user amelie set limit topics = 1;
create topic test;
show limits;
drop topic test;
create topic test;
create topic test2;
drop topic test;

# test: subscriptions
create topic test;
alter user amelie set limit subscriptions = 0;
create subscription test_sub on test;
alter user amelie set limit subscriptions = 1;
create subscription test_sub on test;
drop topic test cascade;

# test: functions
alter user amelie set limit functions = 0;
create function test () begin end;
alter user amelie set limit functions = 1;
create function test () begin end;
select test();
drop function test;

# test: columns
alter user amelie set limit columns = 1;
create table test (id int primary key);
create table test2 (id int primary key, data int);
drop table test;
alter user amelie unset limit columns;

# test: keys
alter user amelie set limit keys = 1;
create table test (id int primary key);
drop table test;
create table test (id int, data int, primary key (id, data));
alter user amelie unset limit keys;

# test: args
alter user amelie set limit args = 0;
create function test() begin end;
create function test2(id int) begin end;
drop function test;
alter user amelie unset limit args;

# test: values
alter user amelie set limit values = 1;
create table test (id int primary key);
insert into test values (1);
insert into test values (2), (3);
drop table test;

create topic test;
publish into test 1;
publish into test 2, 3;
drop topic test;
alter user amelie unset limit values;

# test: partitions
alter user amelie set limit partitions = 1;
create table test (id int primary key) partitions 3;
create table test (id int primary key) partitions 1;
drop table test;
alter user amelie unset limit partitions;

# test: vector
alter user amelie set limit vector = 1;
create table test (id int primary key, v vector(1));
create table test2 (id int primary key, v vector(3));
drop table test;
alter user amelie unset limit vector;
show limits;

disconnect S0;
close E0;
