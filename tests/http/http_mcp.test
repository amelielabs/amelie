#

open E0 "uuid": "00000000-0000-0000-0000-000000000000", "listen": [{ "host": "127.0.0.1", "port": 3485 }];
connect E0 S0 127.0.0.1:3485;

# test: POST /

# test: POST / (initialize)
post / application/json - {"jsonrpc": "2.0", "id": 11, "method": "initialize"};

# test: POST / (tools/list, empty)
post / application/json - {"jsonrpc": "2.0", "id": 11, "method": "tools/list"};

create function plus (a int, b int) return int
begin
  return a + b;
end;

# test: POST / (tools/list)
post / application/json - {"jsonrpc": "2.0", "id": 11, "method": "tools/list"};

# test: POST / (tools/call)
post / application/json - {"jsonrpc": "2.0", "id": 11, "method": "tools/call", "params": { "name": "plus", "arguments": {"a": 1, "b": 2} } };

# test: POST / (tools/call, error)
post / application/json - {"jsonrpc": "2.0", "id": 11, "method": "tools/call", "params": { "name": "plus", "arguments": {"a": 1, "b": 'string'} } };

create function error_as (msg string)
begin
  select error(msg);
end;

# test: POST / (tools/call, non udf)
create table xyz (id int primary key);

post / application/json - {"jsonrpc": "2.0", "id": 11, "method": "tools/call", "params": { "name": "xyz", "arguments": {} } };

# test: POST / (tools/call, error during execution)
post / application/json - {"jsonrpc": "2.0", "id": 11, "method": "tools/call", "params": { "name": "error_as", "arguments": {} } };

# test: POST / (resources/list)
post / application/json - {"jsonrpc": "2.0", "id": 11, "method": "resources/list"};

create function some_resource () return string
begin
  return 'hello world'::sha1;
end;

# test: POST / (resources/read)
post / application/json - {"jsonrpc": "2.0", "id": 11, "method": "resources/list"};

post / application/json - {"jsonrpc": "2.0", "id": 11, "method": "resources/read", "params": { "uri": "mcp://" } };
post / application/json - {"jsonrpc": "2.0", "id": 11, "method": "resources/read", "params": { "uri": "mcp://amelie/zyx" } };
post / application/json - {"jsonrpc": "2.0", "id": 11, "method": "resources/read", "params": { "uri": "mcp://zyx" } };

post / application/json - {"jsonrpc": "2.0", "id": 11, "method": "resources/read", "params": { "uri": "mcp://some_resource" } };

# test: POST / (resources/read, table)
post / application/json - {"jsonrpc": "2.0", "id": 11, "method": "resources/read", "params": { "uri": "mcp://xyz" } };

drop table xyz;

disconnect S0;
close E0;
