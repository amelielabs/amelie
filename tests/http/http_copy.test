#

open E0 "uuid": "00000000-0000-0000-0000-000000000000", "listen": [{ "host": "127.0.0.1", "port": 3485 }];
connect E0 S0 127.0.0.1:3485;

# test: POST /?copy (invalid content type)
post /?copy - - -;
post /?copy json - -;
post /?copy application/json - -;

# test: POST /?copy (text/plain, no accept, no content)
post /?copy text/plain - -;

disconnect S0;
close E0;
