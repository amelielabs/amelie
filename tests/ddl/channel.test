#
open E0 "uuid": "00000000-0000-0000-0000-000000000001", "listen": [{ "host": "127.0.0.1", "port": 3485 }];
connect E0 S0 127.0.0.1:3485;

# test: create channel statement parsing
create channel;
create channel 1;
create channel;
create channel if exists;

# test: create channel
create channel test;
show channels;

# test: create channel (if exists)
create channel test;
create channel if not exists test;

# test: create channel description
create channel test2 description;
create channel test2 description 123;
create channel test2 description 'test test';
show channel test2;

# test: crud/query
insert into test values (123);
delete from test; 
select * from test;

# test: publish (no subscibers)
publish;
publish into;
publish into;
publish into 1;
publish into xyz;

publish into test;
publish into test 123;

# test: drop channel statement parsing
drop channel;
drop channel 123;

# test: drop channel
drop channel test;
drop channel test2;

# test: drop channel (if exists)
drop channel test;
drop channel if exists;
drop channel if exists test;

# test: alter channel statement parsing
create channel test;
show channels;

alter channel;
alter channel test;
alter channel test xyz;
alter channel test 1;

# test: alter channel rename to
alter channel test rename;
alter channel test rename to;
alter channel test rename to xyz;
show channels;

# test: alter channel rename to (if exists)
alter channel test rename to xyz;
alter channel if exists test rename to xyz;
show channels;

publish into xyz 123;
drop channel xyz;

drop channel test;

# test: alter channel description
create channel x;
alter channel x description '__renamed';
show channel x;
drop channel x;

disconnect S0;
close E0;
