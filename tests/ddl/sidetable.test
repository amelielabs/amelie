#

open E0 "uuid": "00000000-0000-0000-0000-000000000001", "listen": [{ "host": "127.0.0.1", "port": 3485 }];
connect E0 S0 127.0.0.1:3485;

# test: create sidetable
create table main (id int primary key);
insert into main values (1);

create table a on main;
show sidetables;

drop table a;
drop table main;

# test: create sidetable (insert)
create table main (id int primary key);
insert into main values (1);

create table a on main;

# error
insert into a values (1);
insert into a values (2);

select * from a;
select * from main;

drop table main;
drop table main cascade;

# test: create sidetable (update)
create table main (id int primary key, data int);
insert into main values (1, 0);
insert into main values (2, 0);
insert into main values (3, 0);
insert into main values (4, 0);

create table a on main;

update a set data = 42 where id in (1, 3);
select * from a;
select * from main;

# test: create sidetable (delete/insert)
delete from a where id < 4;

select * from a;
select * from main;

insert into a values (1, 2);
insert into a values (2, 2);
insert into a values (3, 2);

select * from a;
select * from main;

# test: create sidetable description
create table x on main description;
create table x on main description 1;
create table x on main description 'test test';
show sidetable x;

# test: alter sidetable rename to
alter table a rename to b;

select * from b;
select * from main;

# test: alter sidetable description
alter table x description '__renamed';
show sidetable x;

# test: drop parent sidetable
drop table b;
show sidetables;

# test: cascade (parent sidetable)
create table b on main;
drop table main cascade;

# test: cascade (table)
create table main (id int primary key, data int);
insert into main values (1, 0);
insert into main values (2, 0);
insert into main values (3, 0);
insert into main values (4, 0);

create table a on main;
create table b on main;
show sidetables;

drop table main;
drop table main cascade;
show sidetables;

# test: cascade (table, udf)
create table main (id int primary key, data int);
create table a on main;
create table b on main;

create function f() return int
begin
   return select count(*) from main;
end;

drop table main;
drop table main cascade;
show sidetables;
show functions;

# test: truncate
create table main (id int primary key);
insert into main values (1), (2);
create table a on main;

# not supported
truncate a;

select * from a;

# truncated sidetables
truncate main;
select * from a;

drop table main cascade;

# test: create sidetable (with vector column)
create table test (id int primary key, v vector(1));
create table x on test;
drop table test;

# test: add column (vector column)
create table test (id int primary key);
create table x on test;
alter table test add column v vector(1);
drop table test;
drop table test cascade;

disconnect S0;
close E0;
