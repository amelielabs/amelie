open E0 "uuid": "00000000-0000-0000-0000-000000000000", "listen": [{ "host": "127.0.0.1", "port": 3485 }];
connect E0 S0 127.0.0.1:3485;
# test: create api
create table test (id int primary key, data string);
create clone test_clone on test;
create topic test_topic;
create subscription test_sub_topic on test_topic;
create subscription test_sub_clone on test_clone;
create subscription test_sub_table on test;
create function test_func (arg int)
return int
begin
	return arg * 2;
end;
create api '/v1/api_table' on test;
create api '/v1/api_clone' on test_clone;
create api '/v1/api_topic' on test_topic;
create api '/v1/api_sub_table' on test_sub_table;
create api '/v1/api_sub_topic' on test_sub_topic;
create api '/v1/api_func' on test_func;
# test: POST /custom_api (table)
post /v1/api_table - - {"id": 1, "data": "hello world"};
post /v1/api_table - - [{"id": 2}, {"id": 3}];
select * from test;

id  data
─────────────────
1   hello world
2   null
3   null
select * from test_sub_table;

lsn  cmd    data
──────────────────────────────────────────────
15   write  {"id": 1, "data": "hello world"}
16   write  {"id": 2, "data": null}
16   write  {"id": 3, "data": null}
# test: POST /custom_api (clone)
post /v1/api_clone - - {"id": 123};
select * from test;

id  data
─────────────────
1   hello world
2   null
3   null
select * from test_clone;

id   data
───────────
123  null
select * from test_sub_table;

lsn  cmd    data
──────────────────────────────────────────────
15   write  {"id": 1, "data": "hello world"}
16   write  {"id": 2, "data": null}
16   write  {"id": 3, "data": null}
select * from test_sub_clone;

lsn  cmd    data
───────────────────────────────────────
17   write  {"id": 123, "data": null}
# test: POST /custom_api (topic)
show lsn;

lsn
───
17
show subs verbose;

subs
────
{
  "user": "amelie",
  "name": "test_sub_topic",
  "description": "",
  "rel_user": "amelie",
  "rel": "test_topic",
  "lsn": 5,
  "grants": []
}
{
  "user": "amelie",
  "name": "test_sub_clone",
  "description": "",
  "rel_user": "amelie",
  "rel": "test_clone",
  "lsn": 6,
  "grants": []
}
{
  "user": "amelie",
  "name": "test_sub_table",
  "description": "",
  "rel_user": "amelie",
  "rel": "test",
  "lsn": 7,
  "grants": []
}
post /v1/api_topic - - {"event": 1};
post /v1/api_topic - - {"event": 2};
post /v1/api_topic - - {"event": 3};
select * from test_sub_topic;

lsn  cmd      data
────────────────────────────
18   publish  {"event": 1}
19   publish  {"event": 2}
20   publish  {"event": 3}
# test: POST /custom_api (udf)
post /v1/api_func - - {"arg": 15};
{"columns": ["test_func"], "rows": [[30]]}
# test: POST /custom_api (sub ack)
select * from test_sub_table;

lsn  cmd    data
──────────────────────────────────────────────
15   write  {"id": 1, "data": "hello world"}
16   write  {"id": 2, "data": null}
16   write  {"id": 3, "data": null}
post /v1/api_sub_table - - 15;
select * from test_sub_table;

lsn  cmd    data
─────────────────────────────────────
16   write  {"id": 2, "data": null}
16   write  {"id": 3, "data": null}
disconnect S0;
close E0;
