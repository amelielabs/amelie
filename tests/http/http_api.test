#

open E0 "uuid": "00000000-0000-0000-0000-000000000000", "listen": [{ "host": "127.0.0.1", "port": 3485 }];
connect E0 S0 127.0.0.1:3485;

# test: POST /db/rel (table)
create table test (id int primary key, data string);

create function test_func (arg int)
return int
begin
	return arg * 2;
end;

post /amelie/test - - {"id": 1, "data": "hello world"};
post /amelie/test - - [{"id": 2}, {"id": 3}];

select * from test;

# test: POST /db/rel (udf)
post /amelie/test_func - - {"arg": 15};

disconnect S0;
close E0;
