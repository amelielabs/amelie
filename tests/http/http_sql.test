#

open E0 "uuid": "00000000-0000-0000-0000-000000000000", "listen": [{ "host": "127.0.0.1", "port": 3485 }];
connect E0 S0 127.0.0.1:3485;

# test: POST / (invalid content type)
post / - - -;
post / json - -;
post / application/json - -;

# test: POST / (text/plain, no accept, no content)
post / text/plain - -;

# test: POST / (text/plain, no accept)
post / text/plain - select 1;

# test: POST / (text/plain, invalid accept)
post / text/plain xyz select 1;

# test: POST / (text/plain, application/json)
post / text/plain application/json select 1;

# test: POST / (args parsing)
post /? text/plain application/json select 1;
post /?a text/plain application/json select 1;

post / text/plain application/json select "2024-07-29 18:40:19"::timestamp;
post /?timezone=Asia/Tokyo text/plain application/json select "2024-07-29 18:40:19"::timestamp;
post / text/plain application/json explain select "2024-07-29 18:40:19"::timestamp;

post /?trusted=true text/plain application/json select current_user;

disconnect S0;
close E0;
